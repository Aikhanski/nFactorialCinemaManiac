# Локальная модель через Ollama. LOCAL_* не используется как ключ облака.
# Если LOCAL_* не заданы, остаются прежние OPENAI_BASE_URL, OPENAI_API_KEY и KINO_MODEL.
LOCAL_API_KEY=ollama
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=qwen3.5:4b

# Облачная модель OpenAI. Ключ заполняется локально в .env и в git не попадает.
CLOUD_API_KEY=
CLOUD_BASE_URL=https://api.openai.com/v1
CLOUD_MODEL=

# Запасной локальный вход (LM Studio), если LOCAL_* пусты.
OPENAI_API_KEY=lm-studio
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
KINO_MODEL=qwen3.5-9b-vlm
